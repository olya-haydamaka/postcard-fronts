{
  "name": "postcard-fronts",
  "version": "26.10.1",
  "private": true,
  "description": "Browser-only tool that fits paintings onto postcard fronts and exports print-ready 300 dpi TIFF files (fronts and backs). Nothing leaves your computer.",
  "license": "MIT",
  "author": "Volodymyr Lytvynchyk",
  "homepage": "https://postcards.haydamaka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olya-haydamaka/postcard-fronts.git"
  },
  "bugs": "https://github.com/olya-haydamaka/postcard-fronts/issues",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "wrangler dev --port 8787",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "overrides": {
    "utif": {
      "pako": "2.1.0"
    }
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "pako": "2.1.0",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
