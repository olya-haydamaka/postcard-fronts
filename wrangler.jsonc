{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets-only Worker: no script, Cloudflare serves dist/ and applies public/_headers.
  "name": "postcard-fronts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
  },
  // One public origin only: the custom domain. Cloudflare creates its DNS record and certificate.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "postcards.haydamaka.com", "custom_domain": true }],
}
